// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        Int      @id @default(autoincrement()) // Primary key
  userType  String   @default("USER")
  email     String   @unique
  password  String
  firstName String
  lastName  String
  avatarUrl String? // URL of Avatar image
  phoneNum  String?   @unique
  createdTemplates CodeTemplate[] @relation("AuthoredTemplates")
  savedTemplates  CodeTemplate[] @relation("SavedTemplates")
  //Posts Post[] // One-to-many relation
  createdAt DateTime @default(now())
  updatedAt       DateTime       @updatedAt
}

model CodeTemplate {
  id          Int           @id @default(autoincrement())
  title       String
  explanation String
  language    String
  code        String
  authorId    Int
  author      User          @relation("AuthoredTemplates", fields: [authorId], references: [id])
  savedBy     User[]        @relation("SavedTemplates")
  tags        Tag[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Tag {
  id            Int            @id @default(autoincrement())
  name          String         @unique
  codeTemplates CodeTemplate[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}